; 등불나무 — 단계 1 프로토타입 (모바일 세로 기준)
config_version=5

[application]
config/name="등불나무"
config/description="행복할수록 잊어버리는 동굴에서, 기록으로 다음 날을 이어 가는 게임"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]
GameState="*res://scripts/core/game_state.gd"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]
theme/custom_font="res://assets/fonts/GowunDodum-Regular.ttf"
theme/default_font_size=28

