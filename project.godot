; Godot 4.4+ — independent engine evaluation prototype.
config_version=5

[application]
config/name="Lantern Tree • Mosslight Prototype"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1100
window/size/viewport_height=760
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.065, 0.065, 1)

[input_devices]
pointing/emulate_mouse_from_touch=true
